<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1781785281344242-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon></icon>
	<name>Convert to JXL</name>
	<submenu></submenu>
	<unique-id>1782241146238621-1</unique-id>
	<command>bash ~/.dotfiles/Scripts/MediaConversion/to_jxl.sh %f</command>
	<description>Images -&gt; JXL</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon></icon>
	<name>Convert from JXL</name>
	<submenu></submenu>
	<unique-id>1782251292004613-1</unique-id>
	<command>bash ~/.dotfiles/Scripts/MediaConversion/from_jxl.sh %f</command>
	<description>JXL -&gt; PNG / JPEG(reconstruct) / WEBP(if animated)</description>
	<range>*</range>
	<patterns>*.jxl</patterns>
	<image-files/>
</action>
<action>
	<icon></icon>
	<name>Convert to preferred formats</name>
	<submenu></submenu>
	<unique-id>1782160521914818-1</unique-id>
	<command>foot --hold -e ~/.dotfiles/Scripts/MediaConversion/media_to_preferred_format.sh %F</command>
	<description>Images -&gt; JXL, Audio -&gt; FLAC, Video -&gt; MKV (H.265/FLAC)</description>
	<range>*</range>
	<patterns>*</patterns>
	<startup-notify/>
	<audio-files/>
	<image-files/>
	<video-files/>
</action>
</actions>

{
		"layer": "top",
		"position": "top",
		"margin-top": 12,
		"margin-left": 12,
		"margin-right": 12,
		"margin-bottom": 0,
		"height": 30,
		"spacing": 6,
		"modules-left": [
			"cpu",
			"custom/gpu",
			"custom/memory",
			"network"
		],
		"modules-center": [
			"ext/workspaces"
		],
		"modules-right": [
			"hyprland/window",
			"tray",
			"bluetooth",
			"pulseaudio",
			"battery",
			"hyprland/language",
			"clock",
			"custom/power"
		],
		"network": {
			"interval": 10,
			"format": "{ifname}",
			"format-wifi": "  {bandwidthTotalBits}",
			"format-ethernet": "  {bandwidthTotalBits}",
			"format-disconnected": "", 
			"tooltip-format": "Interface:\t{ifname}\n\nUp b/s:\t\t{bandwidthUpBits}\n\nDown b/s:\t{bandwidthDownBits}",
			"tooltip-format-wifi": "Interface:\t{ifname}\n\nNetwork:\t{essid}\n\nStrength:\t{signalStrength}\n\nFreq:\t\t{frequency}\n\nUp b/s:\t\t{bandwidthUpBits}\n\nDown b/s:\t{bandwidthDownBits}",
			"tooltip-format-disconnected": "Disconnected"
		},
		"custom/gpu": {
			"interval": 10,
			"exec": "~/nix-configuration/modules/home/waybar/config/gpu_info.sh",
			"format": "󰾲  {}",
			"tooltip": false,
			"min-length": 16
		},
		"tray": {
			"icon-size": 15,
			"show-passive-items": true,
			"spacing": 6,
			"icons": {
				"steam": "steam"
			}
		},
		"pulseaudio": {
			"format": "{icon} {volume}% {format_source}",
			"format-bluetooth": "{icon} {volume}% {format_source}",
			"format-bluetooth-muted": " {icon} {format_source}",
			"format-muted": " {format_source}",
			"format-source": " {volume}%",
			"format-source-muted": "",
			"format-icons": {
				"headphone": "",
				"headset": "",
				"phone": "",
				"portable": "",
				"car": "",
				"default": ["", "", ""]
			},
			"on-click": "pwvucontrol"
		},
		"custom/memory": {
			"interval": 10,
			"exec": "~/nix-configuration/modules/home/waybar/config/memory.sh",
			"format": "  {}",
			"tooltip": false,
			"min-length": 16
		},
		"hyprland/workspaces": {
			"format": "{icon}"
		},
		"ext/workspaces": {
			"all-outputs": true,
			"on-click": "activate",
			"active-only": false,
			"format": "{icon}"
		},
		"hyprland/language": {
			"format": "{}",
			"format-en": "🇺🇸",
			"format-ru": "🇷🇺"
		},
		"hyprland/window": {
			"format": "{initialTitle}",
			"icon": true,
			"icon-size": 18
		},
		"cpu": {
			"interval": 10,
			"format": "  {usage}% | {avg_frequency} GHz | {load}",
			"tooltip": true,
			"min-length": 16
		},
		"clock": {
			"interval": 30,
			"locale": "ru_RU.UTF-8",
			"format": "{:%a, %Y-%m-%d, %H:%M}",
			"tooltip-format": "<tt>{calendar}</tt>",
			"calendar": {
				"mode": "year",
				"mode-mon-col": 4,
				"on-scroll": 1,
				"format": {
					"months":	 "<span color='#ffead3'>{}</span>",
					"days":	   "<span color='#ecc6d9'>{}</span>",
					"weeks":	  "<span color='#99ffdd'>{}</span>",
					"weekdays":   "<span color='#ffcc66'>{}</span>",
					"today":	  "<span color='#ff6699'>{}</span>"
				}
			},
			"actions":  {
				"on-click-right": "mode",
				"on-scroll-up": "shift_up",
				"on-scroll-down": "shift_down"
			}
		},
		"bluetooth": {
			"format": " {status}",
			"format-disabled": "",
			"format-connected": " {device_alias}",
			"format-connected-battery": " {device_alias} ({device_battery_percentage}%)",
			"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
			"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\nDevices connected\t({num_connections})\n\n{device_enumerate}",
			"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
			"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
			"on-click": "rofi-bluetooth"
		},
		"battery": {
			"states": {
				"low": 20,
				"medium": 40,
				"high": 60,
				"full": 80
			},
			"interval": 10,
			"tooltip-format": "{timeTo}\n\nConsuming:\t{power:.2f} W\n\nCharge cycles:\t{cycles}\n\nBattery health:\t{health}%",
			"format": "{icon}  {capacity}%",
			"format-time": "{H}:{m}",
			"format-icons": ["", "", "", ""]
		}
}
